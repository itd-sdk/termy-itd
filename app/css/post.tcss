PostWidget {
    background: $surface;
    margin-bottom: 1;
    padding: 1 2;
    height: auto;
}
PostWidget:focus {
    padding: 0 1;
    border: $primary heavy;
}
PostPage > VerticalScroll > PostWidget:focus {
    padding: 1 2;
    border: none;
}

PostsWidget {
    min-height: 3;
    height: auto;
}

.post-top {
    height: 3;
}

.actions {
    width: auto;
}
.actions > * {
    width: auto;
    margin-right: 2;
}
.report, .delete {
    color: $error;
}

.images {
    height: auto;
    margin-bottom: 1;
}
.image {
    height: auto;
    width: auto;
    max-height: 25;
    min-width: 10;
    min-height: 5;
    margin-right: 1;
}

.stats {
    height: 1;
}
.stats > * {
    width: auto;
    margin-right: 1;
}
.likes.active {
    color: $error;
}
.reposts.active {
    color: $success;
}
.views {
    width: auto;
}
.views.active {
    color: $primary;
}
.views.only, .dominant {
    width: 1fr;
    text-align: right;
}

.date {
    color: $foreground-muted;
    width: auto;
    margin-right: 3;
}


OriginalPostWidget {
    margin: 1 5;
    padding: 1 2;
    border: round $primary 50%;
    background: $panel;
}
OriginalPostWidget:focus {
    padding: 1 2;
    border: round $primary;
}

.attach-error {
    width: auto;
    color: red;
    align: center middle;
}


#heading {
    padding: 1 0 0 2;
    background: $surface;
    border-bottom: hkey $foreground-muted;
}

PostPage > Horizontal {
    height: auto;
}
#comment-input {
    width: 7fr;
}
#add-comment {
    width: 1fr;
}

#reply-header {
    background: $panel;
    padding: 0 1 1 1;
    border-left: $primary round;
    border-right: $primary round;
    border-top: $primary round;
    height: 3;
}

#reply-header > Static:first-child {
    width: 90%;
}

#reply-header > Static:last-child {
    width: 10%;
    text-align: right;
    color: red;
}

.pinned-post {
    color: $foreground-muted;
}

.deleted-text {
    color: $error;
    width: 1fr;
    content-align: left middle;
    height: 3;
}

.screen-deleted-text {
    margin-top: 1;
    text-align: center;
    color: $error;
}

.deleted {
    height: 5;
}

#back {
    margin-right: 1;
}
.screen-deleted {
    align: center middle;
    margin-top: 2;
}

.post-event-actors {
    background: $surface-lighten-2;
    padding-left: 2;
    # margin-bottom: 1;
}
